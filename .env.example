# SQLite for local use. On Supabase, paste the pooled connection string (port 6543, "Transaction pooler").
DATABASE_URL=sqlite:///./chatbot.db
# Where contact-form and hand-off emails are sent (needs the SMTP_* settings below).
ESCALATION_EMAIL=info@pinetreemacro.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
CONFIDENCE_HIGH=0.90
CONFIDENCE_LOW=0.74
CLARIFY_MARGIN=0.04
ESCALATION_EXAMPLE_SIMILARITY=0.85
RETENTION_DAYS=30
# Per visitor address; 0 turns a limit off.
RATE_SESSION_PER_HOUR=20
RATE_CONTACT_PER_HOUR=5
RATE_CHAT_PER_MINUTE=30
ALLOWED_ORIGINS=http://localhost:3000
# The address visitors see in the chat.
CONTACT_EMAIL=info@pinetreemacro.com
# Serverless hosts only: a long random string. The host's cron calls /api/internal/purge with it.
CRON_SECRET=
